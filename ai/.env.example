# AI Service Environment Configuration
# =====================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---- Server ----
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8001

# ---- Logging ----
# Options: DEBUG | INFO | WARNING | ERROR
AI_LOG_LEVEL=INFO

# ---- Model ----
# Path to the saved Keras model (.keras file)
# Default resolves to ai/model/saved_models/ecg_model.keras
MODEL_PATH=model/saved_models/ecg_model.keras

# ---- File Limits ----
# Maximum ECG image upload size in bytes (default: 10 MB)
MAX_ECG_SIZE_BYTES=10485760

# ---- CORS ----
# Comma-separated list of allowed origins (backend URL)
AI_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
