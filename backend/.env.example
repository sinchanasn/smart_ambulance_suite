# API Configuration
PROJECT_NAME="Smart Ambulance Suite API"
API_V1_STR="/api/v1"
DEBUG=True
SECRET_KEY="super-secret-key-change-in-production-environment"
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:5500", "*"]

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smart_ambulance_db"

# Firebase Credentials Placeholders
FIREBASE_PROJECT_ID="smart-ambulance-suite"
FIREBASE_PRIVATE_KEY_PATH="path/to/firebase-credentials.json"
